# meeva JS dependency baseline — see /meeva-core:js-dependency-hardening
# Copy to the project root as .npmrc and commit it.
#
# Requires npm 12+: strict-allow-scripts and allowScripts do not exist before it.

# Refuse versions published in the last 7 days (npm counts DAYS).
min-release-age=7

# An unapproved install script is an error, not a warning.
strict-allow-scripts=true

strict-peer-deps=true
prefer-dedupe=true

# Cooldown exemptions: one line per internal package, added deliberately and
# reviewed in the diff. Never a wildcard.
#
# The bracket form is REQUIRED. A repeated plain `min-release-age-exclude=` key
# silently keeps only the LAST line, so every earlier exemption is dropped
# while the file still looks configured.
#
# Exemption is per-package, not transitive: an exempted internal package's own
# third-party dependencies still serve the full cooldown.
#
# min-release-age-exclude[]=@meeva/example
# min-release-age-exclude[]=@meeva/other
